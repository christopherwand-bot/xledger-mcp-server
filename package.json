{
  "name": "@eyevinn/xledger-mcp-server",
  "version": "1.3.1",
  "description": "MCP server for the Xledger GraphQL API: read-only access to accounting data (AR, AP, GL, budget, projects, timesheets, invoicing, expenses, absences)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "xledger-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "dev": "tsc --watch",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "xledger",
    "graphql",
    "accounting",
    "erp",
    "claude"
  ],
  "author": "Eyevinn Technology <info@eyevinn.se> (https://www.eyevinn.se)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eyevinn/xledger-mcp-server.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "jose": "^6.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
